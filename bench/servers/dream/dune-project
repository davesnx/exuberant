(lang dune 3.14)

(name bench_dream)

(generate_opam_files true)

(authors "David Sancho")

(maintainers "David Sancho")

(license MIT)

; Standalone dune project with its own opam file: create a local switch with
; `opam switch create . <compiler> --deps-only` so this server's dependency
; versions live in ./_opam, independent of the other benchmark servers.
(package
 (name bench_dream)
 (allow_empty)
 (synopsis "Hello-world benchmark server: Dream (lwt)")
 (depends
  (ocaml
   (>= 5.1))
  (dream
   (>= 1.0.0~alpha7))))
